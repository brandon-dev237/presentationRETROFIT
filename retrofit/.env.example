# Copier ce fichier en ".env" et remplir les valeurs réelles.
# Ne jamais commiter le fichier ".env" (déjà exclu par .gitignore).
#
# Attention : ces variables sont intégrées dans le code au moment du BUILD
# (npm run build / docker build), pas lues au démarrage — il faut donc
# reconstruire l'image si l'une d'elles change.

# URL de base de l'API backend
VITE_BACKEND_URL=http://localhost:4000

# Devise affichée sur le site (ex: "$", "€")
VITE_CURRENCY=$
