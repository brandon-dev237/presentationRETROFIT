# Image de production pour le frontend : build Vite statique servi par nginx.
# Contrairement à Dockerfile (dev, avec hot-reload), cette image contient
# le code déjà compilé — rien n'est monté en volume, l'image est autonome.

# --- Étape 1 : build ---
# Les variables VITE_* doivent être présentes AU MOMENT DU BUILD
# (Vite les intègre dans les fichiers JS générés, pas au démarrage du conteneur).
FROM node:24-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Reçues via "docker compose build --build-arg" (voir docker-compose.prod.yml) :
# vite build lit ces variables depuis process.env au moment de la compilation.
ARG VITE_BACKEND_URL
ARG VITE_CURRENCY
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_CURRENCY=$VITE_CURRENCY

RUN npm run build

# --- Étape 2 : serveur statique ---
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
