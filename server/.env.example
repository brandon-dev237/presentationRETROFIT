# Copier ce fichier en ".env" et remplir les valeurs réelles.
# Ne jamais commiter le fichier ".env" (déjà exclu par .gitignore).

# Port d'écoute du serveur Express
PORT=4000

# Environnement d'exécution ("development" ou "production")
# Change le comportement des cookies (secure/sameSite) — voir userController.js / sellerControler.js
NODE_ENV=development

# URL de connexion MongoDB Atlas (ou instance locale)
MONGODB_URI=

# Clé secrète utilisée pour signer les tokens JWT (chaîne aléatoire longue)
JWT_SECRET=

# Identifiants du compte vendeur unique (connexion admin)
SELLER_EMAIL=
SELLER_PASSWORD=

# Identifiants Cloudinary (stockage des images produits)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Clés Stripe (paiement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL publique du frontend (pour CORS et les redirections Stripe)
FRONTEND_URL=http://localhost:5173
